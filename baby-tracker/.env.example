# Copy to .env.local in this workspace. Never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
ALLOWED_EMAILS=parent-one@example.com,parent-two@example.com
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173
# AI Gateway uses Vercel OIDC on Vercel. Locally run `vercel env pull`, or set a Gateway key.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
