{
  "name": "baby-tracker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --env-mode=loose",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck",
    "dev:demo": "VITE_DEMO_MODE=true pnpm --filter web dev",
    "test": "pnpm --filter @workspace/api test && vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @workspace/api migrate",
    "postinstall": "pnpm --filter @workspace/domain build"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.9.18",
    "typescript": "~6",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.58.0"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
