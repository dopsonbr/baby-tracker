{
  "name": "@workspace/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/dev.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src test migrations",
    "test": "tsx --test test/*.test.ts",
    "migrate": "tsx --env-file-if-exists=../../.env.local src/migrate.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.18.1",
    "@neondatabase/serverless": "^1.1.0",
    "@workspace/domain": "workspace:*",
    "ai": "^7.0.102",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
