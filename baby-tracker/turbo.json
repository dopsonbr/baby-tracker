{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_CLERK_PUBLISHABLE_KEY"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@workspace/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@workspace/domain#build": {
      "outputs": ["dist/**"]
    }
  },
  "globalEnv": ["VITE_CLERK_PUBLISHABLE_KEY"],
  "globalPassThroughEnv": ["CLERK_*", "DATABASE_URL", "ALLOWED_EMAILS", "AI_*"]
}
